<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://www.semanticweb.org/acer/ontologies/smartbin/demo#"
    xml:base="http://www.semanticweb.org/acer/ontologies/smartbin/demo"
    xmlns:sb="http://www.semanticweb.org/acer/ontologies/smartbin/demo#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/acer/ontologies/smartbin/demo">
        <rdfs:label>SmartBin development demo</rdfs:label>
        <rdfs:comment>A starter ontology containing three warehouses and nine simulated bins. Bin IDs, warehouse assignments, capacities and MQTT topics match the simulator's default fleet. All capacities are illustrative demo values, not verified physical specifications. Enterprise, Rack and Asset are reserved categories with no example individuals yet. MQTT topic values are descriptive metadata; this file does not configure Ditto, publish messages or subscribe to a broker.</rdfs:comment>
        <owl:versionInfo>0.2.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Categories are siblings. Containment is represented by relationships,
         not by making a bin a subclass of a warehouse. -->
    <owl:Class rdf:about="#Enterprise">
        <rdfs:comment>Category reserved for the enterprise or organization. No enterprise individuals are asserted in this first demo.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Warehouse">
        <rdfs:comment>A warehouse in which bins are located.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Rack">
        <rdfs:comment>Category reserved for warehouse racks. Rack assignments have not been supplied and are not asserted.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#SmartBin">
        <rdfs:comment>A bin represented in the development simulator. A SmartBin individual describes a bin; it does not create physical hardware.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Asset">
        <rdfs:comment>Category reserved for assets once their intended meaning and relationship to bins are agreed.</rdfs:comment>
    </owl:Class>

    <owl:ObjectProperty rdf:about="#locatedIn">
        <rdfs:domain rdf:resource="#SmartBin"/>
        <rdfs:range rdf:resource="#Warehouse"/>
        <rdfs:comment>Links a bin to the warehouse where it is located.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#capacityKg">
        <rdfs:domain rdf:resource="#SmartBin"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The configured maximum load in kilograms. Values in this file are editable demo values, not current readings and not volume capacity.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#alertThresholdPercent">
        <rdfs:domain rdf:resource="#SmartBin"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The demo weight alert threshold as a percentage of this bin's rated load. The bridge evaluates the policy when a new reading arrives; this is configuration data, not an OWL inference rule. Values must be greater than zero and at most 100.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#binId">
        <rdfs:domain rdf:resource="#SmartBin"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The bin identifier used by the simulator and in MQTT topics.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#warehouseId">
        <rdfs:domain rdf:resource="#Warehouse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The warehouse identifier used by the simulator and in MQTT topics.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#mqttTopic">
        <rdfs:domain rdf:resource="#SmartBin"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The simulator's default topic for this bin's calibrated weight in kilograms. The default payload is numeric UTF-8 text. This metadata must be updated if the simulator topic prefix or warehouse assignment changes.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- The three warehouse records. -->
    <owl:NamedIndividual rdf:about="#warehouse-a">
        <rdf:type rdf:resource="#Warehouse"/>
        <sb:warehouseId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">warehouse-a</sb:warehouseId>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#warehouse-b">
        <rdf:type rdf:resource="#Warehouse"/>
        <sb:warehouseId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">warehouse-b</sb:warehouseId>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#warehouse-c">
        <rdf:type rdf:resource="#Warehouse"/>
        <sb:warehouseId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">warehouse-c</sb:warehouseId>
    </owl:NamedIndividual>

    <!-- Warehouse A has bins 001, 004 and 007 (10 kg each). -->
    <owl:NamedIndividual rdf:about="#bin-001">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-001</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-a"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-a/bin-001/weight</sb:mqttTopic>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#bin-004">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-004</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-a"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-a/bin-004/weight</sb:mqttTopic>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#bin-007">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-007</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-a"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-a/bin-007/weight</sb:mqttTopic>
    </owl:NamedIndividual>

    <!-- Warehouse B has bins 002, 005 and 008 (50 kg each). -->
    <owl:NamedIndividual rdf:about="#bin-002">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-002</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-b"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-b/bin-002/weight</sb:mqttTopic>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#bin-005">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-005</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-b"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-b/bin-005/weight</sb:mqttTopic>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#bin-008">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-008</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-b"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-b/bin-008/weight</sb:mqttTopic>
    </owl:NamedIndividual>

    <!-- Warehouse C has bins 003, 006 and 009 (100 kg each). -->
    <owl:NamedIndividual rdf:about="#bin-003">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-003</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-c"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-c/bin-003/weight</sb:mqttTopic>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#bin-006">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-006</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-c"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-c/bin-006/weight</sb:mqttTopic>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#bin-009">
        <rdf:type rdf:resource="#SmartBin"/>
        <sb:binId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bin-009</sb:binId>
        <sb:alertThresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</sb:alertThresholdPercent>
        <sb:locatedIn rdf:resource="#warehouse-c"/>
        <sb:capacityKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</sb:capacityKg>
        <sb:mqttTopic rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smartbin/warehouse-c/bin-009/weight</sb:mqttTopic>
    </owl:NamedIndividual>

    <!-- Explicitly state that the twelve records represent distinct things. -->
    <owl:AllDifferent>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="#warehouse-a"/>
            <rdf:Description rdf:about="#warehouse-b"/>
            <rdf:Description rdf:about="#warehouse-c"/>
            <rdf:Description rdf:about="#bin-001"/>
            <rdf:Description rdf:about="#bin-002"/>
            <rdf:Description rdf:about="#bin-003"/>
            <rdf:Description rdf:about="#bin-004"/>
            <rdf:Description rdf:about="#bin-005"/>
            <rdf:Description rdf:about="#bin-006"/>
            <rdf:Description rdf:about="#bin-007"/>
            <rdf:Description rdf:about="#bin-008"/>
            <rdf:Description rdf:about="#bin-009"/>
        </owl:distinctMembers>
    </owl:AllDifferent>
</rdf:RDF>
